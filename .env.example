# Przykładowy .env — skopiuj do .env i uzupełnij. Nigdy nie commituj
# prawdziwego .env (jest w .gitignore): klucze i hashe zostają na serwerze.

# Klucz API Gemini (Google AI Studio) — bez niego panel działa, ale nie
# przetwarza faktur:
GEMINI_API_KEY=

# --- katalogi (opcjonalne) -------------------------------------------------
# Domyślne wartości (data, przetworzone, logi — względem katalogu roboczego)
# są właściwe dla Dockera, gdzie WORKDIR to /app, a volume'y wskazują na
# /app/data i /app/przetworzone. Odkomentuj tylko po to, żeby przenieść
# katalogi (np. przy uruchomieniu poza Dockerem):
# OMEGA_KATALOG_DANYCH=data
# OMEGA_KATALOG_EKSPORTU=przetworzone
# OMEGA_KATALOG_LOGOW=logi

# --- monitoring (Healthchecks.io; puste = monitor/strażnik nie pingują nic) ---
HEALTHCHECKS_URL=
HEALTHCHECKS_STRAZNIK_URL=

# --- logowanie do panelu -----------------------------------------------------
# Puste PANEL_KONTA = logowanie wyłączone (tryb deweloperski, np. desktop.py).
#
# SECRET_KEY podpisuje ciasteczka sesji (wygeneruj raz, nie zmieniaj
# na działającym serwerze — unieważni sesje):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
#
# PANEL_TOKEN — "login" monitora przy odpytywaniu API panelu:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_TOKEN=
#
# PANEL_KONTA = login=hash;login=hash  (hash hasła, NIGDY jawne hasło).
# Hash generuj per konto i sklej średnikiem:
#   python -c "from werkzeug.security import generate_password_hash as g; print('ksiegowa=' + g(input('Hasło: ')))"
# CAŁE POLE w POJEDYNCZYCH cudzysłowach — hash zawiera '$', a docker
# compose w zapisie bez cudzysłowów i w podwójnych cudzysłowach traktuje
# '$cos' jako zmienną i czyści go (hash się psuje). Pojedyncze cudzysłowy
# są dosłowne dla compose i python-dotenv:
PANEL_KONTA=
#
# DOMENA — nazwa, pod którą caddy wystawia panel (https, port 8443).
# Na VPS domena wskazująca na IP serwera (np. omega-faktury.duckdns.org)
# — Caddy sam pobiera certyfikat Let's Encrypt wyzwaniem DNS-01 (nie
# wymaga portów 80/443). Lokalnie do testów: localhost:
DOMENA=localhost

# DUCKDNS_TOKEN — token z duckdns.org (zaloguj się, token widać na górze
# strony). Caddy używa go do wyzwania DNS-01 (zakłada rekord TXT). Token
# kontroluje CAŁE konto Duck DNS — trzymać jak sekret. Jest urlsafe
# (bez '$'), więc cudzysłowy niepotrzebne. Lokalnie może być pusty —
# dla DOMENA=localhost certyfikat idzie z wewnętrznego CA caddy:
DUCKDNS_TOKEN=
