# Przykładowy .env — skopiuj do .env i uzupełnij. Nigdy nie commituj
# prawdziwego .env (jest w .gitignore): klucze i hashe zostają na serwerze.

# Klucz API Gemini (Google AI Studio) — bez niego panel działa, ale nie
# przetwarza faktur:
GEMINI_API_KEY=

# --- monitoring (Healthchecks.io; puste = monitor/strażnik nie pingują nic) ---
HEALTHCHECKS_URL=
HEALTHCHECKS_STRAZNIK_URL=

# --- logowanie do panelu -----------------------------------------------------
# Puste PANEL_KONTA = logowanie wyłączone (tryb deweloperski, np. desktop.py).
#
# SECRET_KEY podpisuje ciasteczka sesji (wygeneruj raz, nie zmieniaj
# na działającym serwerze — unieważni sesje):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
#
# PANEL_TOKEN — "login" monitora przy odpytywaniu API panelu:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_TOKEN=
#
# PANEL_KONTA = login=hash;login=hash  (hash hasła, NIGDY jawne hasło).
# Hash generuj per konto i sklej średnikiem:
#   python -c "from werkzeug.security import generate_password_hash as g; print('ksiegowa=' + g(input('Hasło: ')))"
PANEL_KONTA=
#
# ADRES_VPS — na czym caddy wystawia https (IP serwera; lokalnie 127.0.0.1):
ADRES_VPS=127.0.0.1
