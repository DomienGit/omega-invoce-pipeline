# Caddy — jedyne okno na świat: kończy TLS i przekazuje ruch do panelu
# w sieci compose.
#
# TLS przez wyzwanie DNS-01: Caddy sam zakłada rekord TXT
# _acme-challenge.<domena> API Duck DNS (DUCKDNS_TOKEN z .env, przekazany
# selektywnie w docker-compose.yml) i dostaje prawdziwy certyfikat
# Let's Encrypt — bez otwierania portów 80/443 (na tym hoście zajęte
# przez inną aplikację; HTTP-01 odpada właśnie dlatego). Odnawianie
# automatyczne co ~60 dni.
#
# {$DOMENA} = nazwa z .env. Na VPS omega-faktury.duckdns.org, panel
# osiągalny jako https://omega-faktury.duckdns.org:8443. Lokalnie
# DOMENA=localhost — Caddy wystawia wtedy certyfikat ze swojego CA
# (bez ACME i bez DNS), ostrzeżenie przeglądarki dotyczy tylko testów
# lokalnych.
{
	# issuer ACME ma brać wyzwanie DNS-01 przez Duck DNS; token przychodzi
	# środowiskiem (dla localhost nieistotny — tam nie ma ACME):
	acme_dns duckdns {env.DUCKDNS_TOKEN}
	# nie mamy portu 80, więc przekierowanie http->https jest niemożliwe;
	# bez tej opcji Caddy próbowałby nasłuchiwać na 80 i zapętlał się
	# w restartach (użytkownik i tak wchodzi od razu na https):
	auto_https disable_redirects
}

https://{$DOMENA}:8443 {
	reverse_proxy panel:5000
}

# Sonda monitoringu: monitor (sieć compose) łączy się po wewnętrznej
# nazwie serwisu "caddy", a SNI bez certyfikatu caddy odrzuca — ten blok
# wystawia dla tej nazwy certyfikat wewnętrzny. Ten sam reverse_proxy
# co na górze, więc sonda sprawdza realną drogę caddy -> panel.
https://caddy:8443 {
	tls internal
	reverse_proxy panel:5000
}
